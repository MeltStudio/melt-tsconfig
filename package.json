{
  "name": "@meltstudio/tsconfig",
  "version": "2.1.0",
  "description": "Melt Studio's TSConfig's",
  "repository": "https://github.com/MeltStudio/melt-tsconfig",
  "author": "Melt Studio <dev@meltstudio.co>",
  "license": "MIT",
  "keywords": [
    "typescript",
    "tsconfig"
  ],
  "files": [
    "nextjs.json",
    "node16.json",
    "node18.json",
    "node20.json",
    "node22.json",
    "node24.json",
    "react-native.json",
    "react.json"
  ],
  "scripts": {
    "generate": "./scripts/generate.js",
    "generate:check": "./scripts/check.sh",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@meltstudio/eslint-config": "^3.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
